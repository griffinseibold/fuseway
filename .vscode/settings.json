{
  // --- Agent instructions: one AGENTS.md for every tool ---
  "chat.useAgentsMdFile": true,
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  // The local model is added per user, not here: Chat: Manage Language Models → Custom Endpoint.
  // Values to enter are in .agents/context/local-llm.md. MCP tools (fusion) are in .vscode/mcp.json.

  // --- Keep agents and search out of noise ---
  "search.exclude": {
    "**/*.gguf": true,
    "**/node_modules": true
  },
  "files.watcherExclude": {
    "**/*.gguf": true
  }
}
